# ============================================================================
# INKREPUBLIK — Production environment variables
# ============================================================================
#
# This file documents the variables the app needs in production. It should
# NOT contain real secrets — those go in Render's dashboard, or in a local
# .env file that is gitignored.
#
# When configuring Render, add each of these as a separate environment
# variable in the dashboard's "Environment" tab.
# ============================================================================

ASPNETCORE_ENVIRONMENT=Production

# ---------- Database ----------
# Sqlite for the demo. When the studio signs on, switch to PostgreSql.
DatabaseProvider=Sqlite
DatabasePath=/app/data/inkrepublik.db

# ---------- SMTP ----------
# Obtain API key from https://resend.com/api-keys
Smtp__Enabled=true
Smtp__Host=smtp.resend.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__Username=resend
Smtp__Password=re_GET_FROM_RESEND_DASHBOARD
Smtp__FromAddress=onboarding@resend.dev
Smtp__FromName=Inkrepublik Tattoo Studio

# ---------- Studio ----------
# OwnerEmail must be the email you signed up to Resend with (sandbox limitation).
Studio__OwnerEmail=GET_FROM_RESEND_ACCOUNT
Studio__PublicBaseUrl=https://inkrepublik.onrender.com

# ---------- Admin ----------
Admin__Email=admin@inkrepublik.local
Admin__Password=USE_A_STRONG_PASSWORD