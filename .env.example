 # ============================================================================
# INKREPUBLIK — Production environment variables
# ============================================================================
#
# Copy this file to `.env` for local Docker testing, and fill in real values.
# In Render, set these directly in the dashboard's "Environment" tab.
#
# NEVER commit the real .env file — it's in .gitignore.
# ============================================================================

ASPNETCORE_ENVIRONMENT=Production

# ---------- Database ----------
DatabaseProvider=Sqlite
DatabasePath=/app/data/inkrepublik.db

# ---------- SMTP ----------
Smtp__Enabled=true
Smtp__Host=smtp.resend.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__Username=resend
Smtp__Password=re_REPLACE_WITH_YOUR_API_KEY
Smtp__FromAddress=onboarding@resend.dev
Smtp__FromName=Inkrepublik Tattoo Studio

# ---------- Studio ----------
Studio__OwnerEmail=REPLACE_WITH_OWNER_EMAIL
Studio__PublicBaseUrl=https://REPLACE_WITH_RENDER_URL

# ---------- Admin ----------
Admin__Email=admin@inkrepublik.local
Admin__Password=REPLACE_WITH_STRONG_PASSWORD