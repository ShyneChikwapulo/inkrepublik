cat > .gitignore << 'EOF'
# .NET / build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.cache
*.dll
*.pdb
*.exe

# Rider / VS / VS Code
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
*.DotSettings.user

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]ut/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# EF Core
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings

# Local settings / secrets
appsettings.Local.json
appsettings.Development.local.json
.env
.env.*
!.env.example
*.local

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Node (in case tooling sneaks in)
node_modules/
EOF

# User uploads (kept out of git — these are runtime data, not source)
src/Inkrepublik.Web/wwwroot/uploads/
!src/Inkrepublik.Web/wwwroot/uploads/.gitkeep



# SQLite database files
*.db
*.db-shm
*.db-wal
inkrepublik*.db*