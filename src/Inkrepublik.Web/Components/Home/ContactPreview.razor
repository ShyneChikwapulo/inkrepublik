@* =========================================================================
   CONTACT PREVIEW (home)
   Compact contact form + quick booking CTA.
   ========================================================================= *@

<section class="contact-preview">
    <div class="container">
        <div class="contact-preview-grid">
            <div class="contact-preview-text">
                <OrnamentalDivider Label="Ready When You Are" />
                <h2 class="contact-preview-title">
                    Let's Talk Ink.
                </h2>
                <p class="contact-preview-lead">
                    Have an idea? Send us a message and we'll help shape it into
                    something permanent. Booking requests get a reply within 24 hours.
                </p>

                <div class="contact-preview-actions">
                    <a href="/book" class="btn btn-primary">Book a Session</a>
                    <a href="/contact" class="btn btn-ghost">Full Contact Page</a>
                </div>
            </div>

            <div class="contact-preview-form">
                <ContactForm />
            </div>
        </div>
    </div>
</section>