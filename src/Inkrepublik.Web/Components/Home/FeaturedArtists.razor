@* =========================================================================
   FEATURED ARTISTS (home preview)
   Top 3 active artists pulled from the database.
   ========================================================================= *@

@inject IArtistService ArtistService

<section class="featured-artists">
    <div class="container">
        <OrnamentalDivider Label="Meet the Artists" />
        <h2 class="section-title">The Hands Behind the Ink</h2>

        @if (_artists.Count == 0)
        {
            <p class="empty-state">No artists to display yet.</p>
        }
        else
        {
            <div class="artists-grid">
                @foreach (var artist in _artists)
                {
                    <ArtistCard Artist="artist" />
                }
            </div>

            <div class="view-all">
                <a href="/artists" class="link-gold">View All Artists</a>
            </div>
        }
    </div>
</section>

@code {
    private List<Artist> _artists = [];

    protected override async Task OnInitializedAsync()
    {
        _artists = await ArtistService.GetFeaturedArtistsAsync(3);
    }
}