@page "/admin/artists"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@inject IAdminArtistService ArtistAdmin

<PageTitle>Artists — Inkrepublik Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Artists</h1>
        <p class="admin-page-lead">Your resident artists and piercing specialists.</p>
    </div>
    <a href="/admin/artists/new" class="btn btn-primary">+ New Artist</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="action-message @(_messageIsSuccess ? "action-message--success" : "action-message--error")">
        @_message
    </div>
}

@if (_loading)
{
    <p class="admin-loading">Loading artists…</p>
}
else if (_artists.Count == 0)
{
    <div class="admin-empty">
        <p class="admin-empty-title">No artists yet</p>
        <p class="admin-empty-text">Add your first artist to get started.</p>
    </div>
}
else
{
    <div class="artists-grid">
        @foreach (var artist in _artists)
        {
            <article class="artist-card @(artist.IsActive ? "" : "artist-card--inactive")">
                <div class="artist-image">
                    @if (!string.IsNullOrWhiteSpace(artist.ProfileImagePath))
                    {
                        <img src="@artist.ProfileImagePath" alt="@artist.Name" />
                    }
                    else
                    {
                        <div class="artist-image-placeholder">No photo</div>
                    }
                </div>

                <div class="artist-body">
                    <p class="artist-order">#@artist.DisplayOrder</p>
                    <h3 class="artist-name">@artist.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(artist.Title))
                    {
                        <p class="artist-title">@artist.Title</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(artist.Specialties))
                    {
                        <p class="artist-specialties">@artist.Specialties</p>
                    }

                    <div class="artist-status">
                        @if (artist.IsActive)
                        {
                            <span class="status-pill status-pill--confirmed">Active</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill--completed">Inactive</span>
                        }
                    </div>

                    <div class="artist-actions">
                        <a href="/admin/artists/@artist.Id" class="btn btn-ghost">Edit</a>
                        <button class="btn btn-ghost btn-danger"
                                @onclick="() => Delete(artist)"
                                disabled="@_deleting">Delete</button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@code {
    private List<Artist> _artists = [];
    private bool _loading = true;
    private bool _deleting;
    private string? _message;
    private bool _messageIsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _artists = await ArtistAdmin.GetAllAsync();
        _loading = false;
    }

    private async Task Delete(Artist artist)
    {
        _deleting = true;
        _message = null;

        try
        {
            var (success, reason) = await ArtistAdmin.DeleteAsync(artist.Id);
            if (success)
            {
                _messageIsSuccess = true;
                _message = $"Deleted \"{artist.Name}\".";
                await LoadAsync();
            }
            else
            {
                _messageIsSuccess = false;
                _message = reason ?? "Couldn't delete this artist.";
            }
        }
        finally
        {
            _deleting = false;
        }
    }
}