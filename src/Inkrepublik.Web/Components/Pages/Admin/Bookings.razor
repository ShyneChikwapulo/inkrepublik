@page "/admin/bookings"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Inkrepublik.Domain.Enums
@inject IAdminBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Bookings — Inkrepublik Admin</PageTitle>

<div class="admin-page-header">
    <h1 class="admin-page-title">Bookings</h1>
    <p class="admin-page-lead">All booking requests, in newest-first order.</p>
</div>

<!-- Filters -->
<div class="filters-bar">
    <div class="filter-group">
        <button class="filter-btn @(_statusFilter is null ? "is-active" : "")"
                @onclick="() => SetStatus(null)">
            All
        </button>
        @foreach (var status in FilterStatuses)
        {
            <button class="filter-btn @(_statusFilter == status ? "is-active" : "")"
                    @onclick="() => SetStatus(status)">
                @status
            </button>
        }
    </div>

    <div class="filter-search">
        <input type="text"
               class="form-control"
               placeholder="Search by name, email, or phone…"
               value="@_search"
               @oninput="OnSearchInput" />
    </div>
</div>

@if (_loading)
{
    <p class="admin-loading">Loading bookings…</p>
}
else if (_bookings.Count == 0)
{
    <div class="admin-empty">
        <p class="admin-empty-title">No bookings match</p>
        <p class="admin-empty-text">
            @if (_statusFilter is not null || !string.IsNullOrWhiteSpace(_search))
            {
                <text>Try changing the filter or clearing your search.</text>
            }
            else
            {
                <text>Bookings will appear here as clients submit requests.</text>
            }
        </p>
    </div>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Preferred</th>
                    <th>Artist</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in _bookings)
                {
                    <tr>
                        <td>
                            <span class="cell-strong">@booking.ClientName</span>
                            <span class="cell-muted">@booking.ClientEmail</span>
                        </td>
                        <td>@booking.PreferredDateTime.ToString("ddd d MMM, HH:mm")</td>
                        <td>
                            @if (booking.Artist is not null)
                            {
                                @booking.Artist.Name
                            }
                            else
                            {
                                <span class="cell-muted">Any</span>
                            }
                        </td>
                        <td>
                            <span class="status-pill status-pill--@booking.Status.ToString().ToLower()">
                                @booking.Status
                            </span>
                        </td>
                        <td>@booking.CreatedAt.ToString("d MMM, HH:mm")</td>
                        <td class="cell-actions">
                            <a href="/admin/bookings/@booking.Id" class="cell-link">View →</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="table-footer">@_bookings.Count booking@(_bookings.Count == 1 ? "" : "s")</p>
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private List<BookingRequest> _bookings = [];
    private BookingStatus? _statusFilter;
    private string _search = string.Empty;
    private bool _loading = true;
    private CancellationTokenSource? _searchCts;

    private static readonly BookingStatus[] FilterStatuses =
    [
        BookingStatus.Pending,
        BookingStatus.Confirmed,
        BookingStatus.Completed,
        BookingStatus.Declined,
        BookingStatus.Cancelled,
        BookingStatus.NoShow,
    ];

    protected override async Task OnParametersSetAsync()
    {
        // Apply the ?status= query parameter on first load
        if (_statusFilter is null && !string.IsNullOrWhiteSpace(StatusQuery))
        {
            if (Enum.TryParse<BookingStatus>(StatusQuery, ignoreCase: true, out var parsed))
            {
                _statusFilter = parsed;
            }
        }

        await LoadBookingsAsync();
    }

    private async Task SetStatus(BookingStatus? status)
    {
        _statusFilter = status;
        await LoadBookingsAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;

        // Debounce: cancel any pending search, start a new timer
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(LoadBookingsAsync);
                }
            }
            catch (TaskCanceledException) { /* superseded by newer input */ }
        });
    }

    private async Task LoadBookingsAsync()
    {
        _loading = true;
        try
        {
            _bookings = await BookingService.GetAllAsync(_statusFilter, _search);
        }
        finally
        {
            _loading = false;
        }
    }
}