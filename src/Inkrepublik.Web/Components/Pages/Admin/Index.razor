@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin — Inkrepublik Tattoo Studio</PageTitle>

<h1 class="admin-page-title">Dashboard</h1>
<p class="admin-page-lead">
    Welcome back. Real widgets land in Phase 5B.
</p>

<section class="admin-welcome">
    <div class="admin-welcome-card">
        <h2 class="admin-card-title">What's coming next</h2>
        <ul class="admin-list">
            <li>Booking queue — pending requests that need confirmation</li>
            <li>Today's appointments</li>
            <li>Unread contact messages</li>
        </ul>
    </div>
</section>

<style>
    .admin-page-title {
        font-family: var(--font-display);
        font-size: 2.25rem;
        font-weight: 700;
        color: var(--c-text);
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
    }

    .admin-page-lead {
        font-size: 0.95rem;
        color: var(--c-text-muted);
        font-weight: 300;
        margin-bottom: 3rem;
    }

    .admin-welcome-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border-subtle);
        padding: 2rem;
        max-width: 600px;
    }

    .admin-card-title {
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--c-crimson);
        margin-bottom: 1.25rem;
    }

    .admin-list {
        padding-left: 1.25rem;
        margin: 0;
    }

    .admin-list li {
        font-size: 0.9rem;
        color: var(--c-text-muted);
        line-height: 1.75;
        font-weight: 300;
    }
</style>