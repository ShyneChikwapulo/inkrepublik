@page "/admin/services"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Inkrepublik.Domain.Enums
@inject IAdminServiceCatalogService ServiceAdmin

<PageTitle>Services — Inkrepublik Admin</PageTitle>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Services</h1>
        <p class="admin-page-lead">Your tattoo, piercing, and jewelry menu.</p>
    </div>
    <a href="/admin/services/new" class="btn btn-primary">+ New Service</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="action-message @(_messageIsSuccess ? "action-message--success" : "action-message--error")">
        @_message
    </div>
}

@if (_loading)
{
    <p class="admin-loading">Loading services…</p>
}
else if (_services.Count == 0)
{
    <div class="admin-empty">
        <p class="admin-empty-title">No services yet</p>
        <p class="admin-empty-text">Add your first service to get started.</p>
    </div>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in _services)
                {
                    <tr class="@(service.IsActive ? "" : "row-inactive")">
                        <td class="cell-order">@service.DisplayOrder</td>
                        <td>
                            <span class="cell-strong">@service.Name</span>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <span class="cell-muted">@Truncate(service.Description, 70)</span>
                            }
                        </td>
                        <td>@service.Category</td>
                        <td>@FormatPrice(service)</td>
                        <td>
                            @if (service.TypicalDurationMinutes.HasValue)
                            {
                                @FormatDuration(service.TypicalDurationMinutes.Value)
                            }
                            else
                            {
                                <span class="cell-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (service.IsActive)
                            {
                                <span class="status-pill status-pill--confirmed">Active</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--completed">Inactive</span>
                            }
                        </td>
                        <td class="cell-actions">
                            <a href="/admin/services/@service.Id" class="cell-link">Edit</a>
                            <button class="cell-link cell-link--danger"
                                    @onclick="() => Delete(service)"
                                    disabled="@(_deleting)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="table-footer">@_services.Count service@(_services.Count == 1 ? "" : "s")</p>
}

@code {
    private List<Service> _services = [];
    private bool _loading = true;
    private bool _deleting;
    private string? _message;
    private bool _messageIsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _services = await ServiceAdmin.GetAllAsync();
        _loading = false;
    }

    private async Task Delete(Service service)
    {
        _deleting = true;
        _message = null;

        try
        {
            var (success, reason) = await ServiceAdmin.DeleteAsync(service.Id);

            if (success)
            {
                _messageIsSuccess = true;
                _message = $"Deleted \"{service.Name}\".";
                await LoadAsync();
            }
            else
            {
                _messageIsSuccess = false;
                _message = reason ?? "Couldn't delete this service.";
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string FormatPrice(Service s)
    {
        if (s.PriceFrom is null) return "Enquire";
        if (s.PriceFrom == 0m) return "Free";

        if (s.PriceTo is not null && s.PriceTo != s.PriceFrom)
            return $"R{s.PriceFrom:N0} – R{s.PriceTo:N0}";

        return $"From R{s.PriceFrom:N0}";
    }

    private static string FormatDuration(int minutes)
    {
        if (minutes < 60) return $"{minutes} min";
        var hours = minutes / 60;
        var rem = minutes % 60;
        return rem == 0 ? $"{hours}h" : $"{hours}h {rem}m";
    }

    private static string Truncate(string s, int max)
        => s.Length <= max ? s : s[..max] + "…";
}