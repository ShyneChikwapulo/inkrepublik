@page "/contact"
@rendermode InteractiveServer

@inject ISiteSettingService SiteSettings

<PageTitle>Contact — Inkrepublik Tattoo Studio</PageTitle>

<section class="page-hero">
    <div class="container">
        <OrnamentalDivider Label="Get in Touch" />
        <h1 class="page-title">Contact Us</h1>
        <p class="page-lead">
            Questions, collaborations, or just want to say hi? We're a small
            studio and we read every message.
        </p>
    </div>
</section>

<section class="contact-section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info">
                <h2 class="contact-info-title">Find Us</h2>

                <div class="contact-items">
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                <circle cx="12" cy="10" r="3" />
                            </svg>
                        </div>
                        <div>
                            <p class="contact-item-label">Location</p>
                            <p class="contact-item-value">@_address1<br />@_address2</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                <polyline points="22,6 12,13 2,6" />
                            </svg>
                        </div>
                        <div>
                            <p class="contact-item-label">Email</p>
                            <p class="contact-item-value">@_email</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_phone))
                    {
                        <div class="contact-item">
                            <div class="contact-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.42 2 2 0 0 1 3.57 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69a16 16 0 0 0 5.5 5.5l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.03z" />
                                </svg>
                            </div>
                            <div>
                                <p class="contact-item-label">Phone</p>
                                <p class="contact-item-value">@_phone</p>
                            </div>
                        </div>
                    }

                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12,6 12,12 16,14" />
                            </svg>
                        </div>
                        <div>
                            <p class="contact-item-label">Hours</p>
                            <p class="contact-item-value">
                                @_hoursWeekday<br />
                                @_hoursSaturday<br />
                                @_hoursSunday
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-wrapper">
                <h2 class="contact-info-title">Send Us a Message</h2>
                <ContactForm />
            </div>
        </div>
    </div>
</section>

@code {
    private string _address1 = "";
    private string _address2 = "";
    private string _email = "";
    private string _phone = "";
    private string _hoursWeekday = "";
    private string _hoursSaturday = "";
    private string _hoursSunday = "";

    protected override async Task OnInitializedAsync()
    {
        _address1 = await SiteSettings.GetAsync("contact.address.line1", "Hout Bay");
        _address2 = await SiteSettings.GetAsync("contact.address.line2", "Cape Town, South Africa");
        _email = await SiteSettings.GetAsync("contact.email", "info@inkrepublikcpt.com");
        _phone = await SiteSettings.GetAsync("contact.phone");
        _hoursWeekday = await SiteSettings.GetAsync("contact.hours.weekday", "Tue–Fri: 10:00 – 18:00");
        _hoursSaturday = await SiteSettings.GetAsync("contact.hours.saturday", "Sat: 10:00 – 16:00");
        _hoursSunday = await SiteSettings.GetAsync("contact.hours.sunday", "Sun–Mon: Closed");
    }
}